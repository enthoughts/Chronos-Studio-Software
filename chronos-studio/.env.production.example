# Production template — copy to .env or inject these through platform secrets.
# NEVER commit a real GEMINI_API_KEY. Replace the origin with your real domain.

CHRONOS_DEBUG=false
CHRONOS_ALLOW_ALL_ORIGINS=false
CHRONOS_ALLOWED_ORIGINS=https://your-real-domain.example
CHRONOS_SESSION_TTL_HOURS=2
CHRONOS_UPLOAD_DIR=/tmp/chronos_uploads

# Leave blank for the fully offline assistant, or set through platform secrets.
GEMINI_API_KEY=
CHRONOS_GEMINI_MODEL=gemini-2.5-flash

# PDF / 300-dpi PNG exports in the container image.
INSTALL_BROWSER=1
# CHRONOS_CHROME=/usr/bin/chromium

# Single-container platforms supply their own port; Fly/HF examples use 8080/7860.
PORT=8080
