{
  "name": "chronos-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JASP-like web UI for Chronos Studio: ribbon, pipeline stepper, results pane.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "node scripts/copy-plotly.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "plotly.js-dist-min": "^2.35.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
