# ---------------------------------------------------------------------------
# Chronos Studio — copy to .env and fill in what you need.
# Everything except the AI key is optional; the app runs with no .env at all.
# ---------------------------------------------------------------------------

# --- AI assistant (free tier: https://aistudio.google.com/apikey) -----------
# Leave blank to run in Offline mode: the app is fully usable without it.
GEMINI_API_KEY=
CHRONOS_GEMINI_MODEL=gemini-2.5-flash

# --- Server ---------------------------------------------------------------
CHRONOS_DEBUG=true
CHRONOS_ALLOW_ALL_ORIGINS=true
# CHRONOS_ALLOWED_ORIGINS=https://your-app.example.com

# --- Limits & privacy -----------------------------------------------------
CHRONOS_UPLOAD_DIR=/tmp/chronos_uploads
# Sessions live in memory and expire after this many hours.
CHRONOS_SESSION_TTL_HOURS=6

# --- Optional binaries ----------------------------------------------------
# Path to the X-13ARIMA-SEATS executable, if you have it installed.
# X13AS_PATH=
# Path to a Chromium/Chrome executable for PDF reports and 300-dpi PNG figures.
# Leave unset on a normal laptop; the app also looks in the usual system paths.
# CHRONOS_CHROME=/usr/bin/chromium

# --- Docker ---------------------------------------------------------------
# 1 = bake Chromium into the backend image so PDF / 300-dpi exports work in
# `docker compose up`. 0 (default) keeps the free-tier image small; those two
# export kinds then degrade gracefully into the bundle's errors.txt.
INSTALL_BROWSER=0
